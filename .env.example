# Marka i dane firmy — pozostaw puste do czasu uzyskania prawdziwych danych
COMPANY_NAME="Silesia Auto Skup"
COMPANY_LEGAL_NAME=""
CONTACT_PHONE=""
CONTACT_EMAIL=""
SITE_URL=""
COMPANY_NIP=""
COMPANY_ADDRESS=""
WHATSAPP_NUMBER=""

# Google Ads — integracja jest nieaktywna, dopóki identyfikatory są puste
GOOGLE_ADS_ID=""
GOOGLE_ADS_PHONE_CONVERSION_LABEL=""

# PostgreSQL
DATABASE_URL="postgres://silesia:silesia@localhost:5432/silesia_auto_skup"
DATABASE_SSL="false"
DATABASE_POOL_SIZE="5"

# Infrastruktura: direct | trusted-proxy | vercel | cloudflare
INFRA_PROVIDER="direct"
TRUSTED_PROXY_IP_HEADER="x-real-ip"
VERIFY_SEARCH_BOTS_DNS="true"

# Sekrety — wygeneruj niezależne, losowe wartości przed uruchomieniem
IP_HASH_SECRET=""
SESSION_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
CRON_SECRET=""

# Retencja i centralne progi ryzyka
DATA_RETENTION_DAYS="30"
RISK_REVIEW_VISITS_PER_HOUR="8"
RISK_BLOCK_VISITS_PER_HOUR="30"
RISK_ALLOW_MAX_SCORE="39"
RISK_REVIEW_MAX_SCORE="79"
RISK_FREQUENT_VISITS_MAX_POINTS="60"
RISK_SUSPICIOUS_UA_POINTS="30"
RISK_REPEATED_GCLID_POINTS="30"
RISK_RAPID_REQUEST_POINTS="20"
RISK_NO_CONTACT_POINTS="10"
RISK_DATACENTER_POINTS="20"
RISK_RAPID_WINDOW_SECONDS="5"
RISK_REPEATED_GCLID_THRESHOLD="3"
RISK_NO_CONTACT_VISITS_THRESHOLD="5"
RISK_AUTO_BLOCK_MINUTES="60"
